---
interface Localized {
  en: string;
  fr: string;
  es: string;
}
interface Props {
  eyebrow?: Localized;
  title: Localized;
  line?: Localized;
}
const { eyebrow, title, line } = Astro.props;
---
<section class="max-w-[1240px] 2xl:max-w-[1440px] mx-auto px-4 md:px-8 pt-12 md:pt-20 pb-6 md:pb-10 text-center flex flex-col items-center gap-4">
  {eyebrow && (
    <span class="eyebrow">
      <span data-lang="en">{eyebrow.en}</span>
      <span data-lang="fr" hidden>{eyebrow.fr}</span>
      <span data-lang="es" hidden>{eyebrow.es}</span>
    </span>
  )}
  <h1 class="font-display font-medium text-[40px] md:text-[64px] leading-[1.02] text-ink">
    <span data-lang="en">{title.en}</span>
    <span data-lang="fr" hidden>{title.fr}</span>
    <span data-lang="es" hidden>{title.es}</span>
  </h1>
  {line && (
    <p class="font-display italic text-xl md:text-2xl text-ink-soft max-w-[48ch]">
      <span data-lang="en">{line.en}</span>
      <span data-lang="fr" hidden>{line.fr}</span>
      <span data-lang="es" hidden>{line.es}</span>
    </p>
  )}
  <span class="block w-10 h-px bg-terracotta mt-2" aria-hidden="true"></span>
</section>
