---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import '../styles/global.css';
import { metadata, business, type Localized } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  socialImage?: string;
  socialImageAlt?: string;
  pageClass?: string;
  translations?: { title: Localized; description: Localized };
}

const { title, description, jsonLd, socialImage, socialImageAlt, pageClass = '' } = Astro.props;
const shareImage = new URL(socialImage || '/assets/photos/antoine-portrait-explaining.jpg', Astro.site).toString();
const meta = metadata(Astro.url.pathname, title, description, Astro.props.translations);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="en" data-seo-page>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{meta.en.title}</title>
  <script is:inline type="application/json" id="seo-translations" set:html={JSON.stringify(meta).replace(/</g, '\\u003c')} />
  <meta name="description" content={meta.en.description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@400;500;600;700&display=swap"
  />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={meta.en.title} />
  <meta property="og:description" content={meta.en.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Savor & Stories" />

  {shareImage && <>
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </>}
  <meta name="twitter:title" content={meta.en.title} />
  <meta name="twitter:description" content={meta.en.description} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@graph': [business,
      { '@type': 'Person', '@id': 'https://savornstories.com/#antoine', name: 'Antoine', url: 'https://savornstories.com/about/', image: 'https://savornstories.com/assets/photos/antoine-portrait-explaining.jpg', worksFor: { '@id': business['@id'] }, knowsLanguage: ['en', 'fr', 'es'] },
      { '@type': 'WebSite', '@id': 'https://savornstories.com/#website', name: 'Savor & Stories', url: 'https://savornstories.com/', inLanguage: ['en', 'fr', 'es'], publisher: { '@id': business['@id'] } },
      { '@type': 'WebPage', '@id': canonical + '#webpage', url: canonical, name: meta.en.title, description: meta.en.description, inLanguage: 'en', isPartOf: { '@id': 'https://savornstories.com/#website' }, about: { '@id': business['@id'] } },
    ],
  }).replace(/</g, '\\u003c')} />
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  )}
</head>
<body class:list={['bg-linen text-ink', pageClass]}>
  <a class="skip-link" href="#main-content"><span data-lang="en">Skip to content</span><span data-lang="fr" hidden>Aller au contenu</span><span data-lang="es" hidden>Ir al contenido</span></a>
  <Header />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <Lightbox />
  <script is:inline src="/chat.js" defer></script>

  <script>
    const STORAGE_KEY = 'ss-lang';

    function applyLang(requested: string) {
      const lang = ['en', 'fr', 'es'].includes(requested) ? requested : 'en';
      document.querySelectorAll<HTMLElement>('[data-lang]').forEach((el) => {
        el.hidden = el.getAttribute('data-lang') !== lang;
      });
      document.querySelectorAll<HTMLElement>('.lbtn').forEach((btn) => {
        const active = btn.getAttribute('data-set-lang') === lang;
        btn.classList.toggle('active', active);
        if (btn.tagName === 'BUTTON') btn.setAttribute('aria-pressed', String(active));
        else if (active) btn.setAttribute('aria-current', 'true');
        else btn.removeAttribute('aria-current');
      });
      document.documentElement.lang = lang;
      document.querySelectorAll<HTMLElement>('[data-label-en]').forEach((el) => {
        const label = el.getAttribute(`data-label-${lang}`);
        if (label) el.setAttribute('aria-label', label);
      });
    }

    function setLang(lang: string) {
      try { localStorage.setItem(STORAGE_KEY, lang); } catch { /* Switching works even when storage is unavailable. */ }
      applyLang(lang);
      const target = document.querySelector<HTMLLinkElement>(`link[hreflang="${lang}"]`);
      if (target && new URL(target.href).pathname !== location.pathname) location.assign(new URL(target.href).pathname + location.search + location.hash);
    }

    // Each crawlable URL owns its language; saved preferences never replace its content.
    const initial = document.documentElement.lang || 'en';
    try { localStorage.setItem(STORAGE_KEY, initial); } catch {}
    applyLang(initial);

    document.querySelectorAll<HTMLElement>('.lbtn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-set-lang');
        if (lang) setLang(lang);
      });
    });
  </script>
</body>
</html>
