var RESULT_TIERS = {
  en:[
    {min:7, badge:'🎖️', title:'Field Agent', desc:'All seven cracked. You\'ve earned the full briefing — and it\'s better told standing where it happened.'},
    {min:5, badge:'🕵️', title:'Sharp Recruit', desc:'A strong showing. The rest of the story is waiting on the real tour.'},
    {min:2, badge:'📻', title:'Rookie Signal', desc:'A decent start. The full picture is a lot clearer standing on the actual clifftop with Antoine.'},
    {min:0, badge:'🐚', title:'Fresh Off the Boat', desc:'Plenty to discover — good thing there\'s a whole tour built to fill in the gaps.'}
  ],
  fr:[
    {min:7, badge:'🎖️', title:'Agent de terrain', desc:'Les sept résolus. Vous avez gagné le briefing complet — et il se raconte mieux sur place.'},
    {min:5, badge:'🕵️', title:'Recrue affûtée', desc:'Belle performance. Le reste de l\'histoire vous attend pendant la vraie visite.'},
    {min:2, badge:'📻', title:'Signal débutant', desc:'Un bon début. Le tableau complet est bien plus clair depuis la vraie falaise, avec Antoine.'},
    {min:0, badge:'🐚', title:'Fraîchement débarqué', desc:'Il y a beaucoup à découvrir — heureusement, toute une visite est là pour combler les lacunes.'}
  ],
  es:[
    {min:7, badge:'🎖️', title:'Agente de campo', desc:'Las siete resueltas. Te has ganado el informe completo — y se cuenta mejor en el lugar donde ocurrió.'},
    {min:5, badge:'🕵️', title:'Recluta agudo', desc:'Buen resultado. El resto de la historia te espera en el tour real.'},
    {min:2, badge:'📻', title:'Señal novata', desc:'Un buen comienzo. El panorama completo se ve mucho más claro desde el acantilado real, con Antoine.'},
    {min:0, badge:'🐚', title:'Recién desembarcado', desc:'Mucho por descubrir — menos mal que hay todo un tour para completar los huecos.'}
  ]
};

var LANG = 'en', STAGE = 'intro', current = 0, score = 0, answered = false;
var stage = document.getElementById('stage');
var progressEl = document.getElementById('progress');

function focusHeading(sel){
  var h = document.querySelector(sel);
  if (!h) return;
  h.setAttribute('tabindex','-1');
  h.focus({preventScroll:true});
}

function setLang(l){
  LANG = l;
  document.documentElement.lang = l;
  ['en','fr','es'].forEach(function(k){
    var b = document.getElementById('lbtn-'+k);
    var active = (k===l);
    b.classList.toggle('active', active);
    b.setAttribute('aria-pressed', active ? 'true' : 'false');
  });
  document.getElementById('heroTag').textContent = UI[LANG].heroTag;
  if (STAGE === 'intro') showIntro();
  else if (STAGE === 'round') showRound();
  else showResults();
}

function renderProgress(){
  var html = '';
  for (var i = 0; i < PUZZLES.length; i++){
    var cls = 'dot';
    if (i < current) cls += ' done';
    else if (i === current) cls += ' current';
    html += '<div class="' + cls + '"></div>';
  }
  progressEl.innerHTML = html;
}

function showIntro(moveFocus){
  STAGE = 'intro';
  var t = UI[LANG];
  stage.innerHTML =
    '<div class="intro-card">' +
      '<h2 id="introHeading">' + t.introH1 + '</h2>' +
      '<p>' + t.introP + '</p>' +
      '<div class="rules">' +
        '<div class="rule"><div class="rule-num">' + PUZZLES.length + '</div><div class="rule-label">' + t.ruleClues + '</div></div>' +
        '<div class="rule"><div class="rule-num">90s</div><div class="rule-label">' + t.ruleRoughly + '</div></div>' +
        '<div class="rule"><div class="rule-num">0€</div><div class="rule-label">' + t.ruleCost + '</div></div>' +
      '</div>' +
      '<button class="btn-primary" onclick="startGame()">' + t.startBtn + '</button>' +
    '</div>';
  renderProgress();
  if (moveFocus) focusHeading('#introHeading');
}

function startGame(){
  current = 0; score = 0;
  renderProgress();
  showRound(true);
}

function showRound(moveFocus){
  STAGE = 'round';
  answered = false;
  renderProgress();
  var t = UI[LANG];
  var r = PUZZLES[current][LANG];
  var optsHtml = '';
  for (var i = 0; i < r.options.length; i++){
    optsHtml += '<button class="option" data-i="' + i + '" onclick="pick(' + i + ')">' + r.options[i] + '</button>';
  }
  var noteClass = PUZZLES[current].cipher ? 'note' : 'question';
  var hintHtml = r.hint ? '<div class="note-hint">' + r.hint + '</div>' : '';
  stage.innerHTML =
    '<div class="round-card">' +
      '<div class="round-meta">' +
        '<span class="puzzle-icon">' + PUZZLES[current].icon + '</span>' +
        '<div class="round-meta-text">' +
          '<h2 class="round-label" id="roundHeading">' + t.clueLabel + ' ' + (current + 1) + ' ' + t.ofLabel + ' ' + PUZZLES.length + '</h2>' +
          '<span class="cat-tag">' + r.cat + '</span>' +
        '</div>' +
      '</div>' +
      '<div class="classified-wrap"><span class="classified">' + t.declassified + '</span></div>' +
      '<div class="' + noteClass + '">' + r.note + '</div>' +
      hintHtml +
      '<div id="options">' + optsHtml + '</div>' +
      '<div class="feedback" id="feedback" aria-live="polite">' +
        '<div class="feedback-inner"><div class="feedback-inner-pad">' +
          '<span class="stamp">' + t.fieldReport + '</span>' +
          '<span class="feedback-status" id="feedbackStatus"></span>' + r.fact +
        '</div></div>' +
      '</div>' +
      '<div class="next-btn" id="nextWrap" style="display:none">' +
        '<button class="btn-primary" onclick="nextRound()">' + (current === PUZZLES.length - 1 ? t.claimBadgeBtn : t.nextBtn) + '</button>' +
      '</div>' +
    '</div>';
  if (moveFocus) focusHeading('#roundHeading');
}

function pick(i){
  if (answered) return;
  answered = true;
  var t = UI[LANG];
  var r = PUZZLES[current][LANG];
  var buttons = document.querySelectorAll('#options .option');
  for (var j = 0; j < buttons.length; j++){
    var label = r.options[j];
    buttons[j].disabled = true;
    if (j === r.correct){
      buttons[j].classList.add('correct');
      buttons[j].innerHTML = '<span class="opt-icon" aria-hidden="true">&#10003;</span><span>' + label + '</span><span class="sr-only">' + (j === i ? t.srYourCorrect : t.srCorrectAnswer) + '</span>';
    } else if (j === i){
      buttons[j].classList.add('wrong');
      buttons[j].innerHTML = '<span class="opt-icon" aria-hidden="true">&#10007;</span><span>' + label + '</span><span class="sr-only">' + t.srYourWrong + '</span>';
    } else {
      buttons[j].classList.add('dim');
    }
  }
  if (i === r.correct) score++;
  document.getElementById('feedbackStatus').textContent = (i === r.correct ? t.correctLabel : t.incorrectLabel) + ' ';
  document.getElementById('feedback').classList.add('show');
  document.getElementById('nextWrap').style.display = 'block';
}

function nextRound(){
  current++;
  if (current >= PUZZLES.length) showResults(true);
  else showRound(true);
}

function getTier(){
  var tiers = RESULT_TIERS[LANG];
  for (var i = 0; i < tiers.length; i++){
    if (score >= tiers[i].min) return tiers[i];
  }
  return tiers[tiers.length - 1];
}

function showResults(moveFocus){
  STAGE = 'results';
  progressEl.innerHTML = '';
  var t = UI[LANG];
  var tier = getTier();
  var waText = encodeURIComponent(t.waMsg(score, PUZZLES.length, tier.title));
  stage.innerHTML =
    '<div class="result-card">' +
      '<div class="result-summary" id="resultSummary" role="group">' +
        '<span class="result-badge" aria-hidden="true">' + tier.badge + '</span>' +
        '<div class="result-score">' + score + '/' + PUZZLES.length + '</div>' +
        '<h2 class="result-title">' + tier.title + '</h2>' +
      '</div>' +
      '<div class="result-desc">' + tier.desc + '</div>' +
      '<div class="share-box"><span class="tag">' + t.yourResult + '</span><br>' +
        score + '/' + PUZZLES.length + ' ' + t.cluesCracked + ' — ' + tier.title + '. ' + t.beatIt +
      '</div>' +
      '<a class="wa-btn" href="https://wa.me/33626391783?text=' + waText + '" target="_blank">' +
        '<svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>' +
        t.bookBtn +
      '</a>' +
      '<button class="replay-btn" onclick="showIntro(true)">' + t.playAgainBtn + '</button>' +
    '</div>';
  var summaryEl = document.getElementById('resultSummary');
  if (summaryEl) summaryEl.setAttribute('aria-label', score + ' ' + t.ofLabel + ' ' + PUZZLES.length + '. ' + tier.title + '.');
  if (moveFocus) focusHeading('#resultSummary');
}

showIntro();
</script>
