    es:{cat:'HISTORIA', note:'.--- ..- -... .. .-.. . .', hint:'Morse — ¿cuál fue esta operación?', options:['JUBILEE','OVERLORD','TORCH'], correct:0, fact:'<strong>Operación Jubilee</strong> — el nombre en clave del desembarco de Dieppe, lanzado al amanecer del 19 de agosto de 1942.'}
