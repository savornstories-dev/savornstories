<style is:global>
/* ============================================================
   Crack the Raid, Dieppe — responsive redesign
   Palette: deep navy, slate blue, muted parchment, restrained
   gold. The 1942 Dieppe Raid content is treated as fact, with a
   respectful tone — no cartoon styling, no trivialising copy.
   ============================================================ */
:root{
  --parchment:#eef1ee;
  --paper:#fbf9f4;
  --navy:#17293a;
  --navy-deep:#0f1b27;
  --slate:#2c4a5e;
  --stamp-red:#8a2a38;
  --gold:#b8965a;
  --gold-soft:#e7dcc3;
  --border:#cdd8d4;
  --ink-soft:#3a4448;
  --focus-ring:#99702d;
}

*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:Arial,Helvetica,sans-serif;
  color:#20282c;
  background:var(--parchment);
  min-height:100dvh;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%}
[hidden]{display:none !important}

.sr-only{
  position:absolute;width:1px;height:1px;padding:0;margin:-1px;
  overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;
}

:focus-visible{outline:3px solid var(--focus-ring);outline-offset:3px;border-radius:4px}
.hero :focus-visible,.back-bar :focus-visible{outline-color:#f3ead4}

@media (min-width:768px){
  body{
    background:
      repeating-radial-gradient(circle at 50% -10%, rgba(255,255,255,.035) 0 2px, transparent 2px 46px),
      var(--navy-deep);
    padding-block:clamp(1.5rem,4vw,3.5rem);
  }
}

.game-shell{width:100%;max-width:480px;margin:0 auto}
@media (min-width:768px){
  .game-shell{
    max-width:620px;border-radius:22px;overflow:hidden;
    box-shadow:0 30px 70px -20px rgba(0,0,0,.5), 0 0 0 1px rgba(184,150,90,.18);
  }
}
@media (min-width:1024px){ .game-shell{max-width:clamp(700px,64vw,850px)} }
@media (min-width:1440px){ .game-shell{max-width:900px} }

.back-bar{background:var(--navy-deep);padding:10px 16px}
.back-link{
  display:inline-flex;align-items:center;gap:6px;color:var(--gold-soft);
  text-decoration:none;font-size:12px;font-weight:bold;letter-spacing:.03em;
  min-height:44px;padding:4px 2px;
}
.back-link:active{opacity:.7}

.hero{
  background:
    radial-gradient(circle at 20% 25%, rgba(255,255,255,.05) 0, transparent 42%),
    linear-gradient(165deg,var(--slate) 0%,var(--navy) 75%);
  padding:clamp(26px,5vw,40px) 20px clamp(24px,4vw,32px);
  text-align:center;position:relative;overflow:hidden;
}
.hero-icon{font-size:clamp(30px,4vw,38px);display:block;margin-bottom:6px;animation:float 3s ease-in-out infinite}
.hero-loc{font-size:10px;letter-spacing:.2em;color:var(--gold-soft);text-transform:uppercase;margin-bottom:5px}
.hero-name{
  font-family:Georgia,'Times New Roman',serif;
  font-size:clamp(24px,3vw + 14px,34px);
  font-weight:bold;color:#f4f0e8;letter-spacing:.01em;line-height:1.2;margin:0;
}
.divider{width:40px;height:2px;background:var(--gold);margin:12px auto}
.hero-tag{font-size:clamp(13px,1vw + 10px,15px);color:var(--gold-soft);font-style:italic}

.lang-bar{display:flex;gap:8px;justify-content:center;margin-top:16px}
.lbtn{
  padding:6px 18px;min-height:44px;min-width:44px;
  border:1.5px solid rgba(255,255,255,.3);border-radius:20px;font-size:11px;
  cursor:pointer;letter-spacing:.1em;background:transparent;color:#f4f0e8;
  font-family:Arial,sans-serif;transition:all .2s;
}
.lbtn.active{background:#f4f0e8;color:var(--navy-deep);border-color:#f4f0e8;font-weight:bold}

.body{
  padding:clamp(20px,4vw,30px) clamp(16px,5vw,28px) clamp(26px,5vw,34px);
  background:var(--parchment);
  container-type:inline-size;
}

.progress{display:flex;justify-content:center;gap:8px;margin-bottom:20px}
.dot{width:9px;height:9px;border-radius:50%;background:var(--border);transition:background .3s,transform .3s}
.dot.done{background:var(--slate)}
.dot.current{background:var(--stamp-red);transform:scale(1.35)}

.intro-card,.round-card,.result-card{max-width:640px;margin-inline:auto;width:100%}

.intro-card{
  background:var(--paper);border-radius:16px;border:1px solid var(--border);
  padding:clamp(24px,4vw,34px) clamp(20px,4vw,30px);text-align:center;
}
.intro-card h2{
  font-family:Georgia,'Times New Roman',serif;
  font-size:clamp(20px,1.6vw + 15px,27px);color:var(--navy);margin:0 0 12px;line-height:1.3;font-weight:600;
}
.intro-card p{font-size:clamp(13.5px,.3vw + 13px,15px);color:var(--ink-soft);line-height:1.65;margin:0 0 22px}
.rules{display:flex;justify-content:center;gap:clamp(14px,3vw,26px);margin-bottom:24px;flex-wrap:wrap}
.rule{text-align:center}
.rule-num{font-size:clamp(18px,1vw + 14px,22px);font-weight:bold;color:var(--stamp-red)}
.rule-label{font-size:10px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.06em;margin-top:2px}

.btn-primary{
  display:block;width:100%;min-height:48px;padding:15px;
  background:linear-gradient(135deg,var(--slate),var(--navy-deep));
  color:#fff;border:none;border-radius:14px;font-size:15px;font-weight:bold;
  cursor:pointer;font-family:Arial,sans-serif;transition:opacity .2s,transform .1s;
}
.btn-primary:hover{opacity:.9}
.btn-primary:active{transform:scale(.98)}

.round-card{
  background:var(--paper);border-radius:4px;border:1px solid #cfc3a8;
  padding:clamp(22px,4vw,30px) clamp(18px,4vw,26px);animation:slideIn .35s ease;
  position:relative;
  background-image:repeating-linear-gradient(0deg, rgba(0,0,0,.015) 0px, rgba(0,0,0,.015) 1px, transparent 1px, transparent 3px);
}
.round-meta{display:flex;flex-direction:column;align-items:center;gap:8px;margin-bottom:10px;text-align:center}
.round-meta-text{display:flex;flex-direction:column;align-items:center;gap:6px}
.round-label{
  font-size:10px;letter-spacing:.15em;color:#9a8a6a;text-transform:uppercase;
  font-weight:bold;margin:0;
}
.cat-tag{
  display:inline-block;background:var(--gold-soft);color:var(--navy);
  font-size:10px;font-weight:bold;letter-spacing:.1em;padding:3px 12px;border-radius:20px;
}
.puzzle-icon{display:flex;justify-content:center;line-height:0}
.puzzle-icon svg{width:clamp(38px,5vw,52px);height:clamp(38px,5vw,52px)}

.classified-wrap{text-align:center;margin-bottom:16px}
.classified{
  display:inline-block;font-size:10px;letter-spacing:.2em;color:var(--stamp-red);font-weight:bold;
  border:1.5px solid var(--stamp-red);padding:2px 10px;border-radius:3px;transform:rotate(-2deg);
}

.note{
  font-size:clamp(15px,.5vw + 13px,17px);font-family:'Courier New',monospace;letter-spacing:.08em;
  color:#20282c;text-align:center;line-height:1.6;margin-bottom:8px;overflow-wrap:break-word;
}
.question{
  font-size:clamp(14.5px,.5vw + 12.5px,16px);color:#20282c;text-align:center;line-height:1.6;
  margin-bottom:8px;overflow-wrap:break-word;
}
.note-hint{font-size:11px;color:var(--ink-soft);text-align:center;font-style:italic;margin-bottom:20px}

.option{
  display:flex;align-items:center;gap:10px;width:100%;text-align:left;
  min-height:48px;padding:13px 16px;margin-bottom:10px;background:#fff;
  border:1.5px solid var(--border);border-radius:10px;font-size:14px;font-weight:bold;
  color:#20282c;cursor:pointer;font-family:Arial,sans-serif;
  transition:border-color .2s,background .2s,transform .1s;overflow-wrap:anywhere;
}
.option:hover:not(:disabled){border-color:var(--slate)}
.option:active{transform:scale(.98)}
.option:disabled{cursor:default}
.option.correct{background:#e3ede8;border-color:var(--slate);color:var(--navy-deep);animation:pulseBlue .5s ease}
.option.wrong{background:#f6e6e6;border-color:var(--stamp-red);color:#7a2c3a;animation:shake .4s ease}
.option.dim{opacity:.45}
.opt-icon{flex:none;font-size:15px;line-height:1}
.option.correct .opt-icon{color:var(--slate)}
.option.wrong .opt-icon{color:var(--stamp-red)}

.feedback{
  display:grid;grid-template-rows:0fr;opacity:0;margin-top:0;
  transition:grid-template-rows .35s ease,opacity .3s ease,margin-top .35s ease;
}
.feedback.show{grid-template-rows:1fr;opacity:1;margin-top:16px}
.feedback-inner{overflow:hidden;min-height:0}
.feedback-inner-pad{
  padding:14px 16px;border-radius:6px;background:var(--parchment);border:1px dashed var(--stamp-red);
  font-size:13px;color:var(--ink-soft);line-height:1.6;
}
.feedback strong{color:var(--navy)}
.feedback-status{font-weight:bold;color:#20282c;display:block;margin-bottom:4px}
.stamp{font-size:10px;letter-spacing:.15em;color:var(--stamp-red);font-weight:bold;margin-bottom:6px;display:block}

.next-btn{margin-top:16px}

.result-card{
  background:#fff;border-radius:16px;border:1px solid var(--border);
  padding:clamp(26px,5vw,36px) clamp(20px,4vw,28px);text-align:center;animation:slideIn .4s ease;
}
.result-summary{margin-bottom:6px}
.result-badge{font-size:clamp(42px,5vw,56px);display:block;margin-bottom:8px;animation:badgePop .5s cubic-bezier(.34,1.56,.64,1)}
.result-score{font-size:clamp(28px,3vw + 18px,38px);font-weight:bold;color:#7a2c3a;letter-spacing:.02em}
.result-title{
  font-family:Georgia,'Times New Roman',serif;
  font-size:clamp(18px,.8vw + 14px,21px);font-weight:600;color:var(--navy);margin:6px 0 10px;
}
.result-desc{font-size:14px;color:var(--ink-soft);line-height:1.6;margin-bottom:22px;overflow-wrap:break-word}

.share-box{
  background:var(--parchment);border-radius:12px;padding:14px 16px;margin-bottom:18px;
  font-size:12.5px;color:var(--ink-soft);text-align:left;line-height:1.6;
}
.share-box .tag{display:inline-block;background:var(--gold-soft);color:var(--navy);font-size:10px;font-weight:bold;padding:2px 8px;border-radius:20px;margin-bottom:6px}

.btn-primary,.wa-btn,.replay-btn{max-width:100%}
@media (min-width:768px){
  .btn-primary,.wa-btn,.replay-btn{max-width:420px;margin-inline:auto}
}

.wa-btn{
  display:flex;align-items:center;justify-content:center;gap:10px;width:100%;
  min-height:48px;padding:15px;background:#25d366;color:#fff;border:none;border-radius:14px;
  font-size:14px;font-weight:bold;cursor:pointer;font-family:Arial,sans-serif;margin-bottom:10px;
  text-decoration:none;transition:opacity .2s;
}
.wa-btn:hover{opacity:.88}
.replay-btn{
  display:block;width:100%;min-height:48px;padding:13px;background:transparent;color:#7a2c3a;
  border:1.5px solid var(--border);border-radius:14px;font-size:13px;font-weight:bold;cursor:pointer;
  font-family:Arial,sans-serif;
}

@container (min-width:520px){
  .round-meta{flex-direction:row;align-items:center;text-align:left;gap:16px}
  .round-meta-text{align-items:flex-start}
  .note{text-align:left}
  .question{text-align:left}
  .note-hint{text-align:left}
  .feedback-inner-pad{text-align:left}
  .result-desc{text-align:left}
}

@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@keyframes slideIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulseBlue{0%{box-shadow:0 0 0 0 rgba(44,74,94,.4)}70%{box-shadow:0 0 0 10px rgba(44,74,94,0)}}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
@keyframes badgePop{0%{transform:scale(0) rotate(-15deg);opacity:0}100%{transform:scale(1) rotate(0);opacity:1}}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
}
</style>
</head>
