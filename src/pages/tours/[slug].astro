---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BookingWidget from '../../components/BookingWidget.astro';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({
    params: { slug: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { title, summary, duration, price, priceLabel, schedule, meetingPoint, included, goodToKnow, description, icon, city, heroImage, gallery } = tour.data;

const cityLabel = city === 'bordeaux' ? 'Bordeaux' : 'Dieppe';
const accent = city === 'bordeaux' ? 'text-wine' : 'text-teal';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TouristTrip',
      name: title.en,
      description: summary.en,
      touristType: 'Leisure',
      ...(heroImage ? { image: `https://savorstories.com${heroImage}` } : {}),
      provider: {
        '@type': 'LocalBusiness',
        name: 'Savor & Stories',
        telephone: '+33626391783',
        email: 'contact@savornstories.com',
        address: {
          '@type': 'PostalAddress',
          addressLocality: cityLabel,
          addressCountry: 'FR',
        },
      },
      ...(price ? { offers: { '@type': 'Offer', price: price.replace('€', ''), priceCurrency: 'EUR' } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://savorstories.com/' },
        { '@type': 'ListItem', position: 2, name: cityLabel, item: `https://savorstories.com/${city}` },
        { '@type': 'ListItem', position: 3, name: title.en, item: `https://savorstories.com/tours/${tour.id}` },
      ],
    },
  ],
};
---
<Layout title={`${title.en} | Savor & Stories`} description={summary.en} jsonLd={jsonLd}>
  <div class="max-w-[1240px] 2xl:max-w-[1440px] mx-auto">
    <div class="px-4 md:px-8 pt-6">
      <a href={`/${city}`} class={`text-sm font-semibold ${accent} no-underline`}>
        <span data-lang="en">&larr; Back to {cityLabel} tours</span>
        <span data-lang="fr" hidden>&larr; Retour aux visites de {cityLabel}</span>
        <span data-lang="es" hidden>&larr; Volver a los tours de {cityLabel === 'Bordeaux' ? 'Burdeos' : cityLabel}</span>
      </a>
    </div>

    {heroImage && (
      <div class="px-4 md:px-8 pt-5">
        <img
          src={heroImage}
          alt={title.en}
          class="w-full h-64 md:h-[460px] object-cover rounded-3xl shadow-card"
        />
      </div>
    )}

    <div class="px-4 md:px-8 pt-8 pb-4 flex flex-col gap-3 max-w-[820px]">
      <div class={`text-xs tracking-[0.16em] uppercase font-bold ${cityLabel === 'Bordeaux' ? 'text-terracotta' : 'text-slate'}`}>
        {cityLabel === 'Bordeaux' ? (
          <>
            <span data-lang="en">Bordeaux</span>
            <span data-lang="fr" hidden>Bordeaux</span>
            <span data-lang="es" hidden>Burdeos</span>
          </>
        ) : (
          <span>Dieppe</span>
        )}
        &nbsp;&middot;&nbsp;
        <span data-lang="en">{duration.en}</span>
        <span data-lang="fr" hidden>{duration.fr}</span>
        <span data-lang="es" hidden>{duration.es}</span>
      </div>
      <h1 class="font-display font-medium text-[38px] md:text-[60px] leading-[1.02] text-ink">
        <span data-lang="en">{title.en}</span>
        <span data-lang="fr" hidden>{title.fr}</span>
        <span data-lang="es" hidden>{title.es}</span>
      </h1>
      <p class="font-display italic text-xl text-ink-soft">
        <span data-lang="en">{summary.en}</span>
        <span data-lang="fr" hidden>{summary.fr}</span>
        <span data-lang="es" hidden>{summary.es}</span>
      </p>
    </div>

    <div class="px-4 md:px-8 pb-8 lg:grid lg:grid-cols-[1fr_360px] lg:gap-10 lg:items-start">
      <div>
        <div class="bg-card rounded-3xl shadow-card p-6 md:p-9 prose-tour">
          <div data-lang="en">
            {description.en.map((para: string) => <p>{para}</p>)}
          </div>
          <div data-lang="fr" hidden>
            {description.fr.map((para: string) => <p>{para}</p>)}
          </div>
          <div data-lang="es" hidden>
            {description.es.map((para: string) => <p>{para}</p>)}
          </div>
        </div>

        {gallery.length > 0 && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-5">
            {gallery.map((photo: { src: string; alt: string }) => (
              <div class="zoom rounded-2xl">
                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading="lazy"
                  class="w-full h-32 md:h-40 object-cover"
                />
              </div>
            ))}
          </div>
        )}

        {included.en.length > 0 && (
          <div class="bg-card rounded-3xl shadow-card p-6 md:p-9 mt-5">
            <p class="eyebrow mb-4">
              <span data-lang="en">What's included</span>
              <span data-lang="fr" hidden>Ce qui est inclus</span>
              <span data-lang="es" hidden>Qué incluye</span>
            </p>
            <ul class="text-sm leading-relaxed space-y-2">
              {included.en.map((item: string) => <li data-lang="en" class="flex gap-2"><span class="text-green">&#10003;</span><span>{item}</span></li>)}
              {included.fr.map((item: string) => <li data-lang="fr" hidden class="flex gap-2"><span class="text-green">&#10003;</span><span>{item}</span></li>)}
              {included.es.map((item: string) => <li data-lang="es" hidden class="flex gap-2"><span class="text-green">&#10003;</span><span>{item}</span></li>)}
            </ul>
          </div>
        )}

        <div class="bg-card rounded-3xl shadow-card p-6 md:p-9 mt-5">
          <p class="eyebrow mb-4">
            <span data-lang="en">Good to know</span>
            <span data-lang="fr" hidden>Bon à savoir</span>
            <span data-lang="es" hidden>Es bueno saberlo</span>
          </p>
          <dl class="text-sm space-y-2">
            <div class="flex justify-between gap-3">
              <dt class="text-label">
                <span data-lang="en">Duration</span>
                <span data-lang="fr" hidden>Durée</span>
                <span data-lang="es" hidden>Duración</span>
              </dt>
              <dd class="font-bold text-right">
                <span data-lang="en">{duration.en}</span>
                <span data-lang="fr" hidden>{duration.fr}</span>
                <span data-lang="es" hidden>{duration.es}</span>
              </dd>
            </div>
            {schedule && (
              <div class="flex justify-between gap-3">
                <dt class="text-label">
                  <span data-lang="en">Schedule</span>
                  <span data-lang="fr" hidden>Horaires</span>
                  <span data-lang="es" hidden>Horario</span>
                </dt>
                <dd class="font-bold text-right">
                  <span data-lang="en">{schedule.en}</span>
                  <span data-lang="fr" hidden>{schedule.fr}</span>
                  <span data-lang="es" hidden>{schedule.es}</span>
                </dd>
              </div>
            )}
            <div class="flex justify-between gap-3">
              <dt class="text-label">
                <span data-lang="en">Meeting point</span>
                <span data-lang="fr" hidden>Point de rendez-vous</span>
                <span data-lang="es" hidden>Punto de encuentro</span>
              </dt>
              <dd class="font-bold text-right">
                {meetingPoint ? (
                  <>
                    <span data-lang="en">{meetingPoint.en}</span>
                    <span data-lang="fr" hidden>{meetingPoint.fr}</span>
                    <span data-lang="es" hidden>{meetingPoint.es}</span>
                  </>
                ) : (
                  <span class="italic text-label">
                    <span data-lang="en">Shared with you when you book</span>
                    <span data-lang="fr" hidden>Communiqué au moment de la réservation</span>
                    <span data-lang="es" hidden>Se comparte al reservar</span>
                  </span>
                )}
              </dd>
            </div>
          </dl>
          {goodToKnow && (
            <p class="text-xs text-ink-soft leading-relaxed mt-3">
              <span data-lang="en">{goodToKnow.en}</span>
              <span data-lang="fr" hidden>{goodToKnow.fr}</span>
              <span data-lang="es" hidden>{goodToKnow.es}</span>
            </p>
          )}
        </div>

        <div class="lg:hidden">
          <BookingWidget title={title} price={price} priceLabel={priceLabel} />
        </div>
      </div>

      <div class="hidden lg:block lg:sticky lg:top-24">
        <BookingWidget title={title} price={price} priceLabel={priceLabel} />
      </div>
    </div>
  </div>
</Layout>
